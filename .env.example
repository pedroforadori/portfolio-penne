# Token do Vercel Blob (lista de cases + imagens). Injetado automaticamente
# na Vercel ao conectar um Blob store. Sem ele, o dev usa armazenamento em
# memória populado com lib/seed-data.ts.
BLOB_READ_WRITE_TOKEN=

# Slug não-óbvio onde o admin fica acessível (ex.: /meu-slug-secreto).
ADMIN_PATH=

# Senha de acesso ao admin.
ADMIN_PASSWORD=

# String aleatória longa usada para assinar o cookie de sessão.
SESSION_SECRET=
